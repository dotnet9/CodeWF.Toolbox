<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Platforms>AnyCPU;x64;ARM32;x86</Platforms>
	</PropertyGroup>

	<ItemGroup>
		<None Include="I18n\Language.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Language.tt</DependentUpon>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Xaml.Behaviors" Version="11.3.0-beta1" />
		<PackageReference Include="CodeWF.LogViewer.Avalonia" Version="1.0.7.1" />
		<PackageReference Include="CodeWF.Tools.Image" Version="1.3.5.5" />
		<PackageReference Include="Hashids.net" Version="1.7.0" />
		<PackageReference Include="Prism.DryIoc.Avalonia" Version="9.0.401.11110-pre" />
		<PackageReference Include="Irihi.Ursa.Themes.Semi" Version="1.10.0" />
		<PackageReference Include="Avalonia.ReactiveUI" Version="11.3.0-beta1" />
		<PackageReference Include="AvaloniaEdit.TextMate" Version="11.2.0" />
		<PackageReference Include="TextMateSharp.Grammars" Version="1.0.66" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CodeWF.Core\CodeWF.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="I18n\Language.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Language.tt</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<None Update="I18n\ConverterModule.zh-Hant.xml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="I18n\ConverterModule.en-US.xml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="I18n\ConverterModule.ja-JP.xml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="I18n\Language.tt">
			<Generator>TextTemplatingFileGenerator</Generator>
			<LastGenOutput>Language.cs</LastGenOutput>
		</None>
		<None Update="I18n\ConverterModule.zh-CN.xml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
