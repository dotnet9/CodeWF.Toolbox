<UserControl
    x:Class="CodeWF.Modules.Converter.Views.Base64CodecView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i18n="https://codewf.com"
    xmlns:language="clr-namespace:Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:CodeWF.Modules.Converter.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    x:DataType="vm:Base64CodecViewModel"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:Base64CodecViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, *, Auto, *" RowSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                Classes="Success"
                Command="{Binding EncodeCommand}"
                Content="{i18n:I18n {x:Static language:Base64CodecView.Encode}}" />
            <Button
                Command="{Binding DecodeCommand}"
                Content="{i18n:I18n {x:Static language:Base64CodecView.Decode}}" />
            <Button
                Command="{Binding SwapCommand}"
                Content="{i18n:I18n {x:Static language:Base64CodecView.Swap}}" />
            <Button
                Command="{Binding CopyCommand}"
                Content="{i18n:I18n {x:Static language:Base64CodecView.CopyResult}}" />
            <Button
                Command="{Binding ClearCommand}"
                Content="{i18n:I18n {x:Static language:Base64CodecView.Clear}}" />
        </StackPanel>

		<SelectableTextBlock
            Grid.Row="1"
            FontWeight="SemiBold"
            Text="{i18n:I18n {x:Static language:Base64CodecView.InputText}}" />
        <TextBox
            Grid.Row="2"
            AcceptsReturn="True"
            Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap"
            VerticalContentAlignment="Top" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
			<SelectableTextBlock
                FontWeight="SemiBold"
                Text="{i18n:I18n {x:Static language:Base64CodecView.OutputText}}" />
			<SelectableTextBlock
                Foreground="{DynamicResource SemiRed5}"
                Text="{i18n:I18n {Binding ErrorMessage}}"
                TextWrapping="Wrap" />
        </StackPanel>

        <TextBox
            Grid.Row="4"
            AcceptsReturn="True"
            IsReadOnly="True"
            Text="{Binding OutputText}"
            TextWrapping="Wrap"
            VerticalContentAlignment="Top" />
    </Grid>
</UserControl>
