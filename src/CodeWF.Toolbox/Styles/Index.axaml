<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        xmlns:semi="https://irihi.tech/semi">
    <Styles.Resources>
        <ResourceDictionary>

            <system:Double x:Key="ControlContentThemeFontSize">13</system:Double>
            <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI, Segoe UI, avares://CodeWF.Toolbox/Assets/Fonts#Noto Sans SC</FontFamily>
            <FontFamily x:Key="CodeEditorThemeFontFamily">Cascadia Code, Consolas, Menlo, Monospace, avares://CodeWF.Toolbox/Assets/Fonts#Noto Sans SC</FontFamily>
            <!--  AvaloniaEdit 的 Simple 主题要求宿主提供这几个字体令牌（Fluent 主题过去自带）  -->
            <FontFamily x:Key="FontFamilyNormal">Microsoft YaHei UI, Segoe UI, avares://CodeWF.Toolbox/Assets/Fonts#Noto Sans SC</FontFamily>
            <system:Double x:Key="FontSizeNormal">13</system:Double>
            <FontWeight x:Key="FontWeightNormal">Normal</FontWeight>
        </ResourceDictionary>
    </Styles.Resources>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Simple/AvaloniaEdit.xaml" />

    <Style Selector="Control">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
    </Style>

    <Style Selector="SelectableTextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
    </Style>

    <Style Selector="avaloniaEdit|TextEditor">
        <Setter Property="FontFamily" Value="{DynamicResource CodeEditorThemeFontFamily}" />
    </Style>

    <Style Selector="TextBlock.Tertiary">
        <Setter Property="Foreground" Value="{DynamicResource StudioMuted}" />
    </Style>

    <Style Selector="TextBox.AppInput">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14 0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource StudioMuted}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox.AppInput:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
    </Style>

    <Style Selector="TextBox.AppInput:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
    </Style>

    <Style Selector="ComboBox.AppSelect">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12 0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource StudioMuted}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBox.AppSelect TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
    </Style>

    <Style Selector="ComboBox.AppSelect ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
    </Style>

    <Style Selector="ComboBox.AppSelect ComboBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource StudioRaised}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
    </Style>

    <Style Selector="ComboBox.AppSelect ComboBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource StudioRaised}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
    </Style>

    <Style Selector="Button.AppPrimary">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="Padding" Value="18 0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Theme" Value="{DynamicResource SolidButton}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.AppGhost">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="Padding" Value="18 0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource StudioRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.AppGhost:pointerover">
        <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
    </Style>

    <Style Selector="Border.SurfacePanel">
        <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BoxShadow" Value="0 12 28 0 #120B1430" />
    </Style>
</Styles>
