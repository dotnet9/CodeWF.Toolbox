<codewf:CodeWFWindow
    x:Class="CodeWF.Toolbox.Views.SettingView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:CodeWF.Core;assembly=CodeWF.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:codewf="https://codewf.com"
    xmlns:language="clr-namespace:Localization"
    xmlns:vm="clr-namespace:CodeWF.Toolbox.ViewModels"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Width="720" WindowStartupLocation="CenterOwner"
    Height="560"
    Icon="/Assets/logo.ico"
    Background="{DynamicResource AppSurfaceBrush}"
    TitleBarHeight="48"
    TitleBarBackground="{DynamicResource AppChromeBrush}"
    TitleBarBorderBrush="{DynamicResource AppLineBrush}"
    TitleBarForeground="{DynamicResource AppTextBrush}"
    WindowCornerRadius="8"
    d:DesignHeight="600"
    d:DesignWidth="500"
    mc:Ignorable="d"
    x:DataType="vm:SettingViewModel"
    Title="{codewf:I18n {x:Static language:SettingView.Title}}">
    <Design.DataContext>
        <vm:SettingViewModel />
    </Design.DataContext>
	<codewf:CodeWFWindow.LeftContent>
        <Border
            Width="30"
            Height="30"
            Background="{DynamicResource AppAccentSoftBrush}"
            BorderBrush="{DynamicResource AppLineBrush}"
            BorderThickness="1"
            CornerRadius="8"
            IsHitTestVisible="False">
            <Image Width="20" Height="20" Source="\Assets\logo.ico" />
        </Border>
    </codewf:CodeWFWindow.LeftContent>
    <Grid Margin="22" RowDefinitions="Auto,*" RowSpacing="14">
        <TextBlock
            Margin="4 0"
            HorizontalAlignment="Left"
            TextWrapping="Wrap"
            Classes="Tertiary H6" TextTrimming="CharacterEllipsis"
            Text="{codewf:I18n {Binding #MyTab.Tag}}"
            Theme="{StaticResource TitleTextBlock}" />
        <Border Grid.Row="1" Classes="SurfacePanel" Padding="14">
            <TabControl
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                TabStripPlacement="Top"
                prism:RegionManager.RegionName="{x:Static core:RegionNames.SettingRegion}"
                Name="MyTab">
                <TabControl.Styles>
                    <Style Selector="TabItem">
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="Padding" Value="14 8" />
                        <Setter Property="MinHeight" Value="36" />
                    </Style>
                </TabControl.Styles>
            </TabControl>
        </Border>
    </Grid>
</codewf:CodeWFWindow>
