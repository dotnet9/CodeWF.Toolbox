<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/" xmlns:c="https://codewf.com"
             xmlns:vm="clr-namespace:CodeWF.Toolbox.ViewModels" xmlns:models="clr-namespace:CodeWF.Core.Models;assembly=CodeWF.Core"
             xmlns:cv="clr-namespace:CodeWF.Toolbox.Converters" xmlns:l="clr-namespace:Localization"
             x:Class="CodeWF.Toolbox.Views.MainMenuView" x:Name="Root" x:DataType="vm:MainMenuViewModel"
             prism:ViewModelLocator.AutoWireViewModel="True">
  <UserControl.Resources><cv:IconConverter x:Key="IconConverter" /></UserControl.Resources>
  <Border Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="0,0,0,1">
    <Grid RowDefinitions="38,106">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <TabStrip ItemsSource="{Binding GroupItems}" SelectedItem="{Binding SelectedGroupItem}" Margin="12,0">
          <TabStrip.ItemTemplate><DataTemplate x:DataType="models:ToolMenuItem"><TextBlock Text="{c:I18n {Binding Name}}" /></DataTemplate></TabStrip.ItemTemplate>
        </TabStrip>
      </ScrollViewer>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="12,4,8,6">
          <ItemsControl ItemsSource="{Binding ActiveMenuItems}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Height="92" Orientation="Vertical" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:ToolMenuItem">
                <Button Classes="RibbonCommand" Height="38" Margin="0,2,5,2" Padding="10,5"
                        Command="{Binding #Root.DataContext.OpenToolCommand}" CommandParameter="{Binding}" ToolTip.Tip="{c:I18n {Binding Description}}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="17" Height="17" Data="{Binding Icon, Converter={StaticResource IconConverter}}" Foreground="{DynamicResource StudioAccent}" />
                    <TextBlock Text="{c:I18n {Binding Name}}" VerticalAlignment="Center" FontSize="12" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Border Grid.Column="1" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1,0,0,0" Padding="12" MinWidth="180">
          <StackPanel Spacing="7">
            <Button Content="{c:I18n {x:Static l:Workspace.SplitDocument}}" Click="SplitDocument" />
            <Button Content="{c:I18n {x:Static l:Workspace.CloseAll}}" Click="CloseAllDocuments" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
