<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/" xmlns:dock="using:Dock.Avalonia.Controls"
             xmlns:recycling="using:Avalonia.Controls.Recycling"
             xmlns:vm="clr-namespace:CodeWF.Toolbox.ViewModels"
             x:Class="CodeWF.Toolbox.Views.MainContentView" x:DataType="vm:MainContentViewModel"
             prism:ViewModelLocator.AutoWireViewModel="True">
  <dock:DockControl Layout="{Binding Workspace.Layout}" Margin="8" recycling:ControlRecyclingDataTemplate.ControlRecycling="{StaticResource ToolDocumentRecycling}" />
</UserControl>
