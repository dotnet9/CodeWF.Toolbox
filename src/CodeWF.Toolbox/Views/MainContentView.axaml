<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:core="clr-namespace:CodeWF.Core;assembly=CodeWF.Core"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="clr-namespace:CodeWF.Toolbox.ViewModels"
             xmlns:markup="https://codewf.com"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CodeWF.Toolbox.Views.MainContentView"
             x:DataType="vm:MainContentViewModel">
    <Border Padding="18" Background="{DynamicResource SemiGrey0}">
        <Grid RowDefinitions="Auto, *">
            <Border
                Padding="14 12"
                Background="{DynamicResource SemiGrey0}"
                BorderBrush="{DynamicResource SemiGrey2}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock
                        Classes="H5"
                        FontWeight="SemiBold"
                        Text="{markup:I18n {Binding SelectedMenuItem.Name}}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Classes="Tertiary"
                        FontSize="12"
                        Text="{markup:I18n {Binding SelectedMenuItem.Description}}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <ContentControl
                Grid.Row="1"
                Margin="0 16 0 0"
                prism:RegionManager.RegionName="{x:Static core:RegionNames.ContentRegion}" />
        </Grid>
    </Border>
</UserControl>
