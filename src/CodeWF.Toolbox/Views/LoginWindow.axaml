<u:UrsaWindow xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:prism="http://prismlibrary.com/"
              xmlns:u="https://irihi.tech/ursa"
              xmlns:views="using:CodeWF.Toolbox.Views"
              xmlns:vm="using:CodeWF.Toolbox.ViewModels"
              xmlns:i18n="https://codewf.com"
              xmlns:language="clr-namespace:Localization"
              prism:ViewModelLocator.AutoWireViewModel="True"
              x:Class="CodeWF.Toolbox.Views.LoginWindow"
              x:DataType="vm:LoginViewModel"
              x:Name="loginWindow"
              mc:Ignorable="d"
              Width="350"
              Height="280"
              Title="登录"
              WindowStartupLocation="CenterScreen"
              CanResize="False">
    <u:UrsaWindow.LeftContent>
        <StackPanel x:Name="LogoAndTitle" Grid.Row="0" Grid.Column="0" IsHitTestVisible="False"
                    VerticalAlignment="Center" Classes="h7" Margin="5 5"
                    TextElement.FontWeight="Light" Orientation="Horizontal" ClipToBounds="False">
                <Image Source="\Assets\logo.ico" Height="24" Width="24" IsHitTestVisible="False" />
            <TextBlock Text="{i18n:I18n {x:Static language:MainModule.Title}}" />
        </StackPanel>
	</u:UrsaWindow.LeftContent>
    <Grid Margin="20 40 20 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <!-- 用户名输入 -->
        <StackPanel Grid.Row="0" Margin="0 10 0 5" Orientation="Vertical">
            <TextBlock Text="用户名" Margin="0 0 0 5" />
            <TextBox Text="{Binding Username}" Width="300" Height="30" />
        </StackPanel>
        
        <!-- 密码输入 -->
        <StackPanel Grid.Row="1" Margin="0 10 0 5" Orientation="Vertical">
            <TextBlock Text="密码" Margin="0 0 0 5" />
            <TextBox Text="{Binding Password}" Classes="revealPasswordButton" Width="300" Height="30" />
        </StackPanel>
        
        <!-- 状态信息 -->
        <TextBlock 
            Grid.Row="2" 
            Text="{Binding StatusMessage}" 
            Foreground="Red" 
            HorizontalAlignment="Center" 
            Margin="0 10" 
        />
        
        <!-- 按钮区域 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10">
            <Button 
                Content="登录" 
                Command="{Binding LoginAsync}" 
                CommandParameter="{Binding #loginWindow}"
                Width="100" 
                Height="30" 
                Margin="0 0 10 0" />
            <Button 
                Content="游客登录" 
                Command="{Binding GuestLoginAsync}" 
                CommandParameter="{Binding #loginWindow}" 
                Width="100" 
                Height="30" />
        </StackPanel>
    </Grid>
</u:UrsaWindow>
