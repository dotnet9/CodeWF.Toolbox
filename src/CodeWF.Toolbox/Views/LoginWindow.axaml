<u:UrsaWindow xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:prism="http://prismlibrary.com/"
              xmlns:u="https://irihi.tech/ursa"
              xmlns:views="using:CodeWF.Toolbox.Views"
              xmlns:vm="using:CodeWF.Toolbox.ViewModels"
              xmlns:i18n="https://codewf.com" 
              xmlns:language="clr-namespace:Localization"
              prism:ViewModelLocator.AutoWireViewModel="True"
              x:Class="CodeWF.Toolbox.Views.LoginWindow"
              x:DataType="vm:LoginViewModel"
              x:Name="loginWindow"
              mc:Ignorable="d"
              Width="300"
              Height="280"
              Title="{i18n:I18n {x:Static language:LoginWindow.Title}}"
              WindowStartupLocation="CenterScreen"
              CanResize="False">
    <u:UrsaWindow.Styles>
        <Style Selector="TextBlock.Left">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.Right">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="220" />
            <Setter Property="Height" Value="30" />
        </Style>
        <Style Selector="Button.Common">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="30" />
        </Style>
    </u:UrsaWindow.Styles>
    <u:UrsaWindow.LeftContent>
        <StackPanel x:Name="LogoAndTitle" Grid.Row="0" Grid.Column="0" IsHitTestVisible="False"
                    VerticalAlignment="Center" Classes="h7" Margin="5 5"
                    TextElement.FontWeight="Light" Orientation="Horizontal" ClipToBounds="False">
                <Image Source="\Assets\logo.ico" Height="24" Width="24" IsHitTestVisible="False" />
            <TextBlock Text="{i18n:I18n {x:Static language:MainModule.Title}}" />
        </StackPanel>
	</u:UrsaWindow.LeftContent>
    <Interaction.Behaviors>
                    <EventTriggerBehavior EventName="Closing">
                        <InvokeCommandAction Command="{Binding RaiseClosingHandlerAsync}" />
                    </EventTriggerBehavior>
                </Interaction.Behaviors>
    <Grid Margin="30 60 30 30" RowDefinitions="55 55 30 *">
        <TextBox Grid.Row="0" Text="{Binding Username}" Watermark="{i18n:I18n {x:Static language:LoginWindow.UsernameWatermark}}" Classes="Right" />
        
        <TextBox Grid.Row="1" Text="{Binding Password}" Watermark="{i18n:I18n {x:Static language:LoginWindow.PasswordWatermark}}" Classes="revealPasswordButton Right" />
        
        <!-- 状态信息 -->
        <TextBlock 
            Grid.Row="2" 
            Text="{i18n:I18n {Binding StatusMessage}}" 
            Foreground="Red" 
            HorizontalAlignment="Center" 
            Margin="0 10" 
        />
        
        <!-- 按钮区域 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10">
            <Button Classes="Common"
                Content="{i18n:I18n {x:Static language:LoginWindow.LoginButton}}" 
                Command="{Binding LoginAsync}" 
                CommandParameter="{Binding ElementName=loginWindow}" 
                Margin="0 0 10 0" />
            <Button Classes="Common"
                Content="{i18n:I18n {x:Static language:LoginWindow.GuestLoginButton}}" 
                Command="{Binding GuestLoginAsync}" 
                CommandParameter="{Binding ElementName=loginWindow}" 
                Margin="0 0 0 0" />  
        </StackPanel>
    </Grid>
</u:UrsaWindow>
