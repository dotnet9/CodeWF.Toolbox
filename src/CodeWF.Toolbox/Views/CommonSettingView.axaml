<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:i18n="https://codewf.com"
             xmlns:language="clr-namespace:Localization"
             xmlns:vm="clr-namespace:CodeWF.Toolbox.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CodeWF.Toolbox.Views.CommonSettingView"
             x:DataType="vm:CommonSettingViewModel">
    <Design.DataContext>
        <vm:CommonSettingViewModel />
    </Design.DataContext>

    <Border Padding="6">
        <StackPanel MaxWidth="660" HorizontalAlignment="Left" Spacing="12">
            <Border Background="{DynamicResource AppPanelAltBrush}" BorderBrush="{DynamicResource AppLineBrush}" BorderThickness="1" CornerRadius="8" Padding="16 14">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="24">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{i18n:I18n {x:Static language:CommonSettingView.AutoOpenToolboxAtStartup}}"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        Grid.Column="1"
                        OffContent="{i18n:I18n {x:Static language:CommonSettingView.TurnOff}}"
                        OnContent="{i18n:I18n {x:Static language:CommonSettingView.TurnOn}}"
                        IsChecked="{Binding AutoOpenToolboxAtStartup}"
                        Command="{Binding ChangeAutoOpenToolboxAtStartupHandlerAsync}" />
                </Grid>
            </Border>

            <Border Background="{DynamicResource AppPanelAltBrush}" BorderBrush="{DynamicResource AppLineBrush}" BorderThickness="1" CornerRadius="8" Padding="16 14">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="24">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{i18n:I18n {x:Static language:CommonSettingView.HideTrayIconOnClose}}"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        Grid.Column="1"
                        OffContent="{i18n:I18n {x:Static language:CommonSettingView.TurnOff}}"
                        OnContent="{i18n:I18n {x:Static language:CommonSettingView.TurnOn}}"
                        IsChecked="{Binding HideTrayIconOnClose}"
                        Command="{Binding ChangeHideTrayIconOnCloseHandlerAsync}" />
                </Grid>
            </Border>

            <Border Background="{DynamicResource AppPanelAltBrush}" BorderBrush="{DynamicResource AppLineBrush}" BorderThickness="1" CornerRadius="8" Padding="16 14">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="24">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{i18n:I18n {x:Static language:CommonSettingView.DisplayPromptWhenClosing}}"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        Grid.Column="1"
                        OffContent="{i18n:I18n {x:Static language:CommonSettingView.TurnOff}}"
                        OnContent="{i18n:I18n {x:Static language:CommonSettingView.TurnOn}}"
                        IsChecked="{Binding NeedExitDialogOnClose}"
                        Command="{Binding ChangeDisplayPromptWhenClosingHandlerAsync}" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
