<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
    xmlns:mdctl="clr-namespace:Markdown.Avalonia.Controls;assembly=Markdown.Avalonia">

    <Style Selector="ctxt|CTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SemiGrey8}" />
        <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    </Style>
    <Style Selector="ctxt|CTextBlock.Heading1">
        <Setter Property="Foreground" Value="{DynamicResource SemiGrey9}" />
        <Setter Property="Margin" Value="0 0 0 12" />
    </Style>
    <Style Selector="ctxt|CTextBlock.Heading2">
        <Setter Property="Foreground" Value="{DynamicResource SemiGrey9}" />
        <Setter Property="Margin" Value="0 18 0 8" />
    </Style>
    <Style Selector="ctxt|CTextBlock.Heading3">
        <Setter Property="Foreground" Value="{DynamicResource SemiGrey9}" />
        <Setter Property="Margin" Value="0 16 0 6" />
    </Style>
    <Style Selector="ctxt|CTextBlock.Heading4">
        <Setter Property="Foreground" Value="{DynamicResource SemiGrey9}" />
    </Style>
    <Style Selector="ctxt|CTextBlock.Heading5">
        <Setter Property="Foreground" Value="{DynamicResource SemiGrey9}" />
    </Style>
    <Style Selector="ctxt|CTextBlock.Heading6">
        <Setter Property="Foreground" Value="{DynamicResource SemiGrey9}" />
    </Style>

    <Style Selector="ctxt|CCode">
        <Setter Property="Foreground" Value="{DynamicResource SemiBlue6}" />
        <Setter Property="FontFamily" Value="{DynamicResource CodeEditorThemeFontFamily}" />
    </Style>

    <Style Selector="ctxt|CHyperlink">
        <Setter Property="Foreground" Value="{DynamicResource SemiBlue6}" />
    </Style>

    <Style Selector="mdctl|Rule.Single">
        <Setter Property="Foreground" Value="{DynamicResource SemiGrey4}" />
    </Style>
    <Style Selector="mdctl|Rule.TwoLines">
        <Setter Property="Foreground" Value="{DynamicResource SemiGrey4}" />
    </Style>
    <Style Selector="mdctl|Rule.Bold">
        <Setter Property="Foreground" Value="{DynamicResource SemiGrey4}" />
    </Style>
    <Style Selector="mdctl|Rule.BoldWithSingle">
        <Setter Property="Foreground" Value="{DynamicResource SemiGrey4}" />
    </Style>

    <Style Selector="ctxt|CHyperlink:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorLight2}" />
    </Style>

    <Style Selector="Border.Table">
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Grid.Table">
        <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
    </Style>

    <Style Selector="Border.TableHeader">
        <Setter Property="Margin" Value="1 0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SemiGrey2}" />
    </Style>

    <Style Selector="Border.OddTableRow">
        <Setter Property="Margin" Value="1 1" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
    </Style>

    <Style Selector="Border.EvenTableRow">
        <Setter Property="Margin" Value="1 1" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SemiGrey1}" />
    </Style>

    <Style Selector="Border.TableHeader ctxt|CTextBlock">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
</Styles>
