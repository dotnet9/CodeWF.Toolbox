<UserControl
    x:Class="CodeWF.Controls.Views.MarkdownView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CodeWF.Controls.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://codewf.com"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border
        Padding="18 14"
        Background="{DynamicResource SemiGrey0}"
        ClipToBounds="True">
        <ScrollViewer
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <md:MarkdownViewer Markdown="{CompiledBinding $parent[local:MarkdownView].Markdown}" />
        </ScrollViewer>
    </Border>
</UserControl>
