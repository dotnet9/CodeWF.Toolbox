<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:local="using:CodeWF.Controls.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CodeWF.Controls.Views.MarkdownView">
  <md:MarkdownScrollViewer Markdown="{CompiledBinding $parent[local:MarkdownView].Markdown}"
                           MarkdownStyleName="GithubLike"
                           VerticalAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           SaveScrollValueWhenContentUpdated="True">
      <md:MarkdownScrollViewer.Styles>
          <StyleInclude Source="avares://CodeWF.Controls/Styles/Markdown.axaml" />
      </md:MarkdownScrollViewer.Styles>
  </md:MarkdownScrollViewer>
</UserControl>
