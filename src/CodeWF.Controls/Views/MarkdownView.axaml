<UserControl
    x:Class="CodeWF.Controls.Views.MarkdownView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CodeWF.Controls.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border
        Padding="18 14"
        Background="{DynamicResource SemiGrey0}"
        ClipToBounds="True">
        <md:MarkdownScrollViewer
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Markdown="{CompiledBinding $parent[local:MarkdownView].Markdown}"
            MarkdownStyleName="GithubLike"
            SaveScrollValueWhenContentUpdated="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            <md:MarkdownScrollViewer.Styles>
                <StyleInclude Source="avares://CodeWF.Controls/Styles/Markdown.axaml" />
            </md:MarkdownScrollViewer.Styles>
        </md:MarkdownScrollViewer>
    </Border>
</UserControl>
