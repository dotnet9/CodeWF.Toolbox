<Project>
    <PropertyGroup>
        <AvaloniaVersion>11.3.12</AvaloniaVersion>
        <DataGridVersion>11.3.12</DataGridVersion>
    </PropertyGroup>

    <!-- 全局自定义宏：精准区分Windows/Linux/macOS + 架构 -->
    <!-- 1. Windows 系统（按架构区分） -->
    <PropertyGroup Condition="'$(OS)' == 'Windows_NT' And '$(Platform)' == 'x64'">
        <DefineConstants>$(DefineConstants);WIN64</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(OS)' == 'Windows_NT' And '$(Platform)' == 'x86'">
        <DefineConstants>$(DefineConstants);WIN32</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(OS)' == 'Windows_NT' And '$(Platform)' == 'ARM64'">
        <DefineConstants>$(DefineConstants);WINARM64</DefineConstants>
    </PropertyGroup>

    <!-- 2. Linux 系统（按架构区分） -->
    <!-- 方式1：通过OS判断（Linux终端中$(OS)为"Linux"） -->
    <PropertyGroup Condition="'$(OS)' == 'Linux' And '$(Platform)' == 'x64'">
        <DefineConstants>$(DefineConstants);LINUX64</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(OS)' == 'Linux' And '$(Platform)' == 'ARM64'">
        <DefineConstants>$(DefineConstants);LINUXARM64</DefineConstants>
    </PropertyGroup>

    <!-- 3. macOS 系统（按架构区分） -->
    <!-- 方式1：通过OS判断（macOS终端中$(OS)为"Darwin"） -->
    <PropertyGroup Condition="'$(OS)' == 'Darwin' And '$(Platform)' == 'x64'">
        <DefineConstants>$(DefineConstants);MAC64</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(OS)' == 'Darwin' And '$(Platform)' == 'ARM64'">
        <DefineConstants>$(DefineConstants);MACARM64</DefineConstants>
    </PropertyGroup>

    <!-- 兜底：通过RID判断（更通用，跨终端/IDE） -->
    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
        <DefineConstants>$(DefineConstants);LINUX64</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">
        <DefineConstants>$(DefineConstants);LINUXARM64</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64'">
        <DefineConstants>$(DefineConstants);MAC64</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
        <DefineConstants>$(DefineConstants);MACARM64</DefineConstants>
    </PropertyGroup>

    <!-- 调试模式默认值（避免调试时无宏） -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug' And '$(OS)' == 'Windows_NT'">
        <DefineConstants>$(DefineConstants);WIN64</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug' And '$(OS)' == 'Linux'">
        <DefineConstants>$(DefineConstants);LINUX64</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug' And '$(OS)' == 'Darwin'">
        <DefineConstants>$(DefineConstants);MAC64</DefineConstants>
    </PropertyGroup>
</Project>
