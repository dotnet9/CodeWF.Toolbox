<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ReactiveUIAvaloniaVersion>12.0.1</ReactiveUIAvaloniaVersion>
    <SemiAvaloniaVersion>12.0.1</SemiAvaloniaVersion>
    <PrismVersion>8.1.97.11073</PrismVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.0.3" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0-beta.98" />
    <PackageVersion Include="CodeWF.AvaloniaControls.Themes" Version="12.0.3.2" />
    <PackageVersion Include="CodeWF.AvaloniaControls.ProDataGrid" Version="12.0.3.1" />
    <PackageVersion Include="CodeWF.EventBus" Version="3.4.5.1" />
    <PackageVersion Include="CodeWF.Log.Core" Version="12.0.2.1" />
    <PackageVersion Include="CodeWF.Tools" Version="1.3.13.0" />
    <PackageVersion Include="CodeWF.Tools.Files" Version="1.3.13.0" />
    <PackageVersion Include="CodeWF.Tools.Image" Version="1.3.13.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.0" />
    <PackageVersion Include="CronExpressionDescriptor" Version="2.45.0" />
    <PackageVersion Include="Dapper" Version="2.1.72" />
    <PackageVersion Include="Dapper.AOT" Version="1.0.48" />
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <PackageVersion Include="Figgle" Version="0.6.6" />
    <PackageVersion Include="Figgle.Fonts" Version="0.6.6" />
    <PackageVersion Include="Hashids.net" Version="1.7.0" />
    <PackageVersion Include="IbanNet" Version="6.1.0" />
    <PackageVersion Include="Irihi.Ursa.PrismExtension" Version="2.0.0" />
    <PackageVersion Include="Irihi.Ursa.Themes.Semi" Version="2.0.0" />
    <PackageVersion Include="Lang.Avalonia.Json" Version="12.0.2.1" />
    <PackageVersion Include="libphonenumber-csharp" Version="9.0.30" />
    <PackageVersion Include="Markdig" Version="1.2.0" />
    <PackageVersion Include="CodeWF.Markdown.Lite.Themes" Version="12.0.3.1" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0-preview.4.26230.115" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="NBitcoin" Version="10.0.4" />
    <PackageVersion Include="NUlid" Version="1.7.3" />
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
    <PackageVersion Include="Prism.Avalonia" Version="$(PrismVersion)" />
    <PackageVersion Include="Prism.DryIoc.Avalonia" Version="$(PrismVersion)" />
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="$(ReactiveUIAvaloniaVersion)" />
    <PackageVersion Include="Semi.Avalonia" Version="$(SemiAvaloniaVersion)" />
    <PackageVersion Include="Semi.Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.3" />
    <PackageVersion Include="Tomlyn" Version="2.4.0" />
    <PackageVersion Include="UAParser" Version="3.1.47" />
    <PackageVersion Include="VC-LTL" Version="5.3.1" />
    <PackageVersion Include="Xaml.Behaviors" Version="12.0.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0-pre.4" />
    <PackageVersion Include="YamlDotNet" Version="17.1.0" />
    <PackageVersion Include="YY-Thunks" Version="1.2.2-Beta.2" />
  </ItemGroup>
</Project>